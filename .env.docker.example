# =============================================================================
# HelpDeskCore - variables de entorno dentro de Docker
#
# El contenedor genera este fichero automaticamente la primera vez que arranca.
# Cualquier variable definida en docker-compose.yml tiene prioridad sobre las
# de aqui, asi que este fichero sirve sobre todo como referencia de valores.
# =============================================================================

APP_NAME=HelpDeskCore
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Base de datos -----------------------------------------------------------
# La ruta /data es un volumen de Docker, asi el fichero sobrevive a
# `docker compose down` y a la reconstruccion de la imagen.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

# --- Sesiones, colas y cache -------------------------------------------------
# Los tres usan la base de datos, por eso los servicios `queue` y `scheduler`
# de docker-compose.yml son obligatorios.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Redis (opcional, no se usa por defecto) ---------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo (opcional, por defecto escribe en el log) ------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (opcional) ----------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend ----------------------------------------------------------------
# La SPA usa window.location.origin, por lo que no hace falta fijar la URL
# del API: sirve en el host y en cualquier dominio sin tocar nada.
VITE_APP_NAME="${APP_NAME}"
